{
  "name": "Tide responsive app compositions",
  "version": "1.3.1",
  "kitVersion": "1.2.1",
  "kitManifest": "kit/component-manifest.json",
  "layer": "tide.app",
  "runtime": "HTML/CSS with three optional deferred search/navigation scripts; help pages are script-free",
  "compositions": [
    {
      "block": "tide-app",
      "purpose": "Contained app shell and responsive results/detail relationship",
      "elements": [
        "header",
        "nav",
        "nav-link",
        "workspace",
        "results",
        "intro",
        "search",
        "search-label",
        "filter-row",
        "filters",
        "filter-form",
        "result-heading",
        "selected",
        "result-footer",
        "detail",
        "attendance",
        "form-wrap",
        "form",
        "field-row",
        "site-footer",
        "skip",
        "month-nav",
        "month-link",
        "month",
        "month-header",
        "month-title",
        "month-count"
      ],
      "modifiers": [
        "event"
      ],
      "states": [
        "aria-current on navigation",
        "open on native details",
        "data-preview on the paired card"
      ]
    },
    {
      "block": "tide-review",
      "purpose": "Review gallery only; not shipped as product UI",
      "elements": [
        "wrap",
        "header",
        "nav",
        "pair",
        "figure",
        "viewport",
        "notes"
      ],
      "layer": "tide.review"
    }
  ],
