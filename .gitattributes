# Keep generated bytes and review diffs consistent across Windows and Unix.
* text=auto eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.woff binary
*.woff2 binary
*.zip binary
# Preserve imported map-provider dependencies and provenance byte-for-byte.
application-kits/lineup/src/map/vendor/** -text
application-kits/lineup/src/map/maps/** -text
